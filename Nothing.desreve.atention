<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>نظام حضور جامعة التقنية الشمالية</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script src="https://unpkg.com/html5-qrcode"></script>
    
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@400;700;900&display=swap');
        body { font-family: 'Noto Sans Arabic', sans-serif; -webkit-tap-highlight-color: transparent; touch-action: manipulation; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .qr-container canvas, .qr-container img { margin: 0 auto; border-radius: 1rem; border: 4px solid #fff; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
        #reader { width: 100% !important; border: none !important; }
        #reader video { border-radius: 1.5rem; object-fit: cover !important; }
        .animate-in { animation: fadeIn 0.15s cubic-bezier(0.4, 0, 0.2, 1) forwards; will-change: transform, opacity; }
        @keyframes fadeIn { from { opacity: 0; transform: scale(0.98); } to { opacity: 1; transform: scale(1); } }
        #admin-modal, #manual-modal, #subject-modal, #pin-modal { display: none; }
        #admin-modal.active, #manual-modal.active, #subject-modal.active, #pin-modal.active { display: flex; }
        button:active { transform: scale(0.96); transition: transform 0.05s ease-in-out; }
    </style>
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen pb-10">

    <header class="p-4 bg-white shadow-sm border-b text-center sticky top-0 z-50">
        <h1 class="text-blue-700 font-bold text-lg">Northern Technical University</h1>
        <h2 class="text-red-600 font-semibold text-xs">كلية التقنيات الصحية والطبية - كركوك</h2>
    </header>

    <main class="max-w-xl mx-auto p-4" id="app-root">
        <div class="flex items-center justify-center h-64">
            <div class="flex flex-col items-center gap-4">
                <div class="animate-spin rounded-full h-10 w-10 border-t-2 border-blue-600"></div>
                <p class="text-xs font-bold text-slate-400">جاري التحميل...</p>
            </div>
        </div>
    </main>

    <!-- Admin Login Modal -->
    <div id="admin-modal" class="fixed inset-0 z-[100] bg-slate-900/60 backdrop-blur-sm items-center justify-center p-4">
        <div class="bg-white rounded-[2rem] p-8 w-full max-sm shadow-2xl animate-in">
            <h3 class="text-xl font-black mb-6 text-center text-slate-800">دخول الإدارة</h3>
            <div class="space-y-4">
                <input id="adm-user" type="text" placeholder="اسم المستخدم" class="w-full p-4 bg-slate-50 rounded-2xl border-none outline-none font-bold text-center shadow-inner">
                <input id="adm-pass" type="password" placeholder="كلمة المرور" class="w-full p-4 bg-slate-50 rounded-2xl border-none outline-none font-bold text-center shadow-inner">
                <button id="adm-confirm" class="w-full py-4 bg-blue-600 text-white font-black rounded-2xl shadow-lg transition-transform duration-75">متابعة</button>
                <button id="adm-cancel" class="w-full py-2 text-slate-400 font-bold text-sm">إلغاء</button>
            </div>
        </div>
    </div>

    <!-- PIN Modal for Subjects -->
    <div id="pin-modal" class="fixed inset-0 z-[120] bg-slate-900/60 backdrop-blur-sm items-center justify-center p-4">
        <div class="bg-white rounded-[2rem] p-8 w-full max-sm shadow-2xl animate-in">
            <h3 class="text-xl font-black mb-6 text-center text-slate-800">رمز حماية المواد</h3>
            <div class="space-y-4">
                <input id="subject-pin-input" type="password" placeholder="أدخل الرمز" class="w-full p-4 bg-slate-50 rounded-2xl border-none outline-none font-bold text-center shadow-inner">
                <button id="btn-pin-confirm" class="w-full py-4 bg-indigo-600 text-white font-black rounded-2xl shadow-lg transition-transform duration-75">دخول</button>
                <button id="btn-pin-cancel" class="w-full py-2 text-slate-400 font-bold text-sm">إلغاء</button>
            </div>
        </div>
    </div>

    <!-- Subject Modal -->
    <div id="subject-modal" class="fixed inset-0 z-[100] bg-slate-900/60 backdrop-blur-sm items-center justify-center p-4">
        <div class="bg-white rounded-[2rem] p-6 w-full max-sm shadow-2xl animate-in border border-slate-100">
            <h3 class="text-lg font-black mb-4 text-center text-slate-800 border-b pb-2">إدارة المواد</h3>
            <div class="space-y-4">
                <p class="text-xs text-slate-500 font-bold text-center">الإضافة للمرحلة <span id="sub-modal-stage" class="text-blue-600"></span> - <span id="sub-modal-type" class="text-blue-600"></span></p>
                <input id="new-subject-name" type="text" placeholder="اسم المادة الجديدة" class="w-full p-4 bg-slate-50 rounded-2xl border-none outline-none font-bold shadow-inner">
                <button id="btn-save-subject" class="w-full py-3 bg-indigo-600 text-white font-black rounded-2xl shadow-lg transition-transform duration-75">إضافة المادة</button>
                <div class="border-t pt-2 mt-2">
                     <p class="text-[10px] font-bold text-slate-400 mb-2 text-center">المواد الحالية (اضغط للحذف)</p>
                     <div id="current-subjects-list" class="flex flex-wrap gap-2 max-h-32 overflow-y-auto justify-center"></div>
                </div>
                <button id="subject-close-btn" class="w-full py-2 text-slate-400 font-bold text-sm bg-slate-50 rounded-xl">إغلاق</button>
            </div>
        </div>
    </div>

    <!-- Manual Attendance Modal -->
    <div id="manual-modal" class="fixed inset-0 z-[110] bg-slate-900/60 backdrop-blur-sm items-center justify-center p-4">
        <div class="bg-white rounded-[2rem] p-6 w-full max-sm shadow-2xl animate-in border border-slate-100">
            <h3 class="text-lg font-black mb-4 text-center text-slate-800 border-b pb-2">إضافة حضور يدوي</h3>
            <div class="space-y-4">
                <p class="text-xs text-slate-500 font-bold text-center">سجل حضور لطالب بدون مسح الكود</p>
                <select id="manual-stu-select" class="w-full p-4 bg-slate-50 rounded-2xl border-none outline-none font-bold text-slate-700 shadow-inner">
                    <option value="">اختر الطالب...</option>
                </select>
                <button id="btn-confirm-manual" class="w-full py-4 bg-green-600 text-white font-black rounded-2xl shadow-lg transition-transform duration-75">تثبيت الحضور</button>
                <button id="manual-close-btn" class="w-full py-2 text-slate-400 font-bold text-sm">إلغاء</button>
            </div>
        </div>
    </div>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.1.0/firebase-app.js";
        import { getFirestore, collection, doc, setDoc, getDoc, getDocs, addDoc, onSnapshot, query, where, deleteDoc, serverTimestamp } from "https://www.gstatic.com/firebasejs/11.1.0/firebase-firestore.js";
        import { getAuth, signInAnonymously, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.1.0/firebase-auth.js";

        const firebaseConfig = {
            apiKey: "AIzaSyBZfsS5xjUyunwIt_cHaPWHQI3H_lzYXoo",
            authDomain: "ntumlt.firebaseapp.com",
            projectId: "ntumlt",
            storageBucket: "ntumlt.firebasestorage.app",
            messagingSenderId: "658799327665",
            appId: "1:658799327665:web:8841af44d52aa7caa12590"
        };

        const app = initializeApp(firebaseConfig);
        const db = getFirestore(app);
        const auth = getAuth(app);
        const appId = "ntumlt-attendance-v2";

        let userRole = localStorage.getItem('role') || null;
        let userData = JSON.parse(localStorage.getItem('userData')) || null;
        let adminStage = localStorage.getItem('adminStage') || 'الأولى';
        let adminType = localStorage.getItem('adminType') || 'صباحي';
        let html5QrCode = null;
        let localStudentsCache = {}; 

        const render = (html) => {
            const root = document.getElementById('app-root');
            if (root) {
                root.innerHTML = `<div class="animate-in">${html}</div>`;
                lucide.createIcons();
            }
        };

        const notify = (msg, isError = false) => {
            const oldToast = document.querySelector('.toast-msg');
            if(oldToast) oldToast.remove();
            const toast = document.createElement('div');
            toast.className = `toast-msg fixed top-24 left-1/2 -translate-x-1/2 z-[200] px-6 py-3 rounded-2xl shadow-2xl text-white font-bold animate-in flex items-center gap-2 ${isError ? 'bg-red-500' : 'bg-green-600'}`;
            toast.innerHTML = isError ? `<i data-lucide="alert-circle" size="18"></i> ${msg}` : `<i data-lucide="check-circle" size="18"></i> ${msg}`;
            document.body.appendChild(toast);
            lucide.createIcons();
            setTimeout(() => { 
                if(toast) { 
                    toast.style.opacity = '0'; 
                    toast.style.transition = 'opacity 0.1s'; 
                    setTimeout(() => toast.remove(), 100); 
                } 
            }, 1000); 
        };

        window.deleteEntry = async (type, id) => {
            if (!confirm('هل تريد الحذف بالتأكيد؟')) return;
            try {
                const coll = type === 'att' ? 'attendance' : 'members';
                const docRef = doc(db, 'artifacts', appId, 'public', 'data', coll, id);
                await deleteDoc(docRef);
                notify('تم الحذف فوراً');
            } catch (err) { notify('خطأ في الاتصال', true); }
        };

        const goBackToHome = () => {
            if (html5QrCode) { try { html5QrCode.stop(); } catch(e) {} html5QrCode = null; }
            localStorage.clear();
            userRole = null; userData = null;
            showLogin();
        };

        const startApp = async () => {
            onAuthStateChanged(auth, (user) => {
                if (!user) signInAnonymously(auth).catch(() => {});
                showView();
            });
        };

        const showView = () => {
            if (!userRole) return showLogin();
            if (userRole === 'admin') return showAdmin();
            if (userRole === 'student') return showStudent();
        };

        const showLogin = () => {
            render(`
                <div class="mt-8 bg-white p-8 rounded-[2.5rem] shadow-xl border border-slate-100 animate-in">
                    <h3 class="text-2xl font-black text-center mb-2 text-slate-800">بوابة الدخول</h3>
                    <p class="text-xs text-slate-400 font-bold text-center mb-8">يرجى ادخال معلوماتك لتتمكن من تسجيل حضور</p>
                    <div class="space-y-4">
                        <input id="stu-name" type="text" placeholder="اسم طالب/طالبة رباعي" class="w-full p-4 bg-slate-50 rounded-2xl border-none outline-none font-bold text-center shadow-sm">
                        <div class="grid grid-cols-2 gap-2">
                             <select id="stu-stage" class="w-full p-4 bg-slate-50 rounded-2xl border-none outline-none font-bold text-slate-600 shadow-sm">
                                <option value="" disabled selected>المرحلة</option>
                                <option value="الأولى">الأولى</option><option value="الثانية">الثانية</option>
                                <option value="الثالثة">الثالثة</option><option value="الرابعة">الرابعة</option>
                            </select>
                             <select id="stu-type" class="w-full p-4 bg-slate-50 rounded-2xl border-none outline-none font-bold text-slate-600 shadow-sm">
                                <option value="" disabled selected>نوع الدراسة</option>
                                <option value="صباحي">صباحي</option>
                                <option value="مسائي">مسائي</option>
                                <option value="استضافة صباحي">استضافة صباحي</option>
                            </select>
                        </div>
                        <div class="grid grid-cols-2 gap-2">
                            <input id="stu-pin" type="password" placeholder="رمز الدخول" class="w-full p-4 bg-slate-50 rounded-2xl border-none outline-none font-bold text-center shadow-sm">
                            <input id="stu-confirm" type="password" placeholder="تأكيد الرمز" class="w-full p-4 bg-slate-50 rounded-2xl border-none outline-none font-bold text-center shadow-sm">
                        </div>
                        <button id="btn-stu-login" class="w-full py-4 bg-blue-600 text-white font-black rounded-2xl shadow-lg transition-transform duration-75 text-lg">دخول / إنشاء حساب</button>
                    </div>
                    <div class="mt-10 pt-6 border-t">
                        <button id="open-admin-modal" class="w-full py-3 bg-slate-50 text-slate-500 rounded-xl font-bold text-sm flex items-center justify-center gap-2 hover:bg-slate-100 transition-colors">
                            <i data-lucide="shield-check" size="16"></i> دخول المسؤول (إدارة النظام)
                        </button>
                    </div>
                </div>
            `);
            document.getElementById('btn-stu-login').onclick = async () => {
                const name = document.getElementById('stu-name').value.trim();
                const stage = document.getElementById('stu-stage').value;
                const type = document.getElementById('stu-type').value;
                const pin = document.getElementById('stu-pin').value;
                const nameParts = name.split(/\s+/).filter(p => p.length > 0);
                if (nameParts.length < 4) return notify('يجب كتابة الاسم رباعي كاملاً', true);
                if (!name || !stage || !type || !pin || pin !== document.getElementById('stu-confirm').value) return notify('تأكد من البيانات والرموز', true);
                const btn = document.getElementById('btn-stu-login'); btn.disabled = true;
                try {
                    const q = query(collection(db, 'artifacts', appId, 'public', 'data', 'members'), where("name", "==", name));
                    const snap = await getDocs(q);
                    if (!snap.empty) {
                        const existing = snap.docs[0].data();
                        if (existing.pin === pin) { userData = existing; userRole = 'student'; saveS(); showStudent(); }
                        else notify('الرمز خطأ', true);
                    } else {
                        const newId = auth.currentUser?.uid || "u_" + Date.now();
                        const newStu = { uid: newId, name, role: 'student', stage, type, department: 'مختبرات طبية', pin };
                        await setDoc(doc(db, 'artifacts', appId, 'public', 'data', 'members', newId), newStu);
                        userData = newStu; userRole = 'student'; saveS(); showStudent();
                    }
                } catch (e) { notify('خطأ اتصال', true); }
                btn.disabled = false;
            };
            document.getElementById('open-admin-modal').onclick = () => document.getElementById('admin-modal').classList.add('active');
        };

        const saveS = () => { localStorage.setItem('role', userRole); localStorage.setItem('userData', JSON.stringify(userData)); };
        document.getElementById('adm-cancel').onclick = () => document.getElementById('admin-modal').classList.remove('active');
        document.getElementById('adm-confirm').onclick = () => {
            if (document.getElementById('adm-user').value === "NTU" && document.getElementById('adm-pass').value === "NTU_mlt12#45@56") {
                document.getElementById('admin-modal').classList.remove('active');
                userRole = 'admin'; localStorage.setItem('role', 'admin'); showAdmin();
            } else notify('البيانات خاطئة', true);
        };

        const showStudent = () => {
            if (!userData) return showLogin();
            render(`
                <div class="bg-white rounded-[2.5rem] shadow-2xl border border-slate-100 overflow-hidden animate-in">
                    <div class="p-6 text-center border-b bg-slate-50/50">
                        <h2 class="text-xl font-black text-blue-800 mb-2">${userData.name}</h2>
                         <div class="flex justify-between items-center px-2 mt-4 bg-white p-3 rounded-xl shadow-sm border border-slate-100">
                             <div class="text-center w-1/3 border-l"><span class="text-[10px] text-slate-400 block font-bold">المرحلة</span><span class="text-sm font-black text-slate-700">${userData.stage}</span></div>
                             <div class="text-center w-1/3 border-l"><span class="text-[10px] text-slate-400 block font-bold">الدراسة</span><span class="text-sm font-black text-slate-700">${userData.type}</span></div>
                             <div class="text-center w-1/3"><span class="text-[10px] text-slate-400 block font-bold">القسم</span><span class="text-sm font-black text-slate-700">مختبرات طبية</span></div>
                        </div>
                    </div>
                    <div class="p-8 text-center flex flex-col items-center">
                        <div id="qrcode" class="qr-container mb-8"></div>
                        <p class="text-[10px] text-slate-400 font-bold mb-6 flex items-center gap-1"><i data-lucide="scan-line" size="12"></i> الباركود جاهز للمسح</p>
                        <button id="back-home-stu" class="w-full py-4 text-blue-600 border border-blue-100 rounded-2xl font-black flex items-center justify-center gap-2 bg-blue-50/50 hover:bg-blue-100 transition-colors"><i data-lucide="home"></i> عودة الى شاشة رئيسية</button>
                    </div>
                </div>
            `);
            setTimeout(() => {
                const qrCont = document.getElementById("qrcode");
                if (qrCont && userData?.uid) {
                    qrCont.innerHTML = "";
                    new QRCode(qrCont, { text: userData.uid, width: 220, height: 220, colorDark: "#1e40af", correctLevel: QRCode.CorrectLevel.L });
                }
            }, 150);
            document.getElementById('back-home-stu').onclick = goBackToHome;
        };

        const showAdmin = () => {
            let currentTab = 'scan';
            let currentLogData = []; 

            const prefetchStudents = async () => {
                localStudentsCache = {}; 
                const q = query(collection(db, 'artifacts', appId, 'public', 'data', 'members'), where('stage', '==', adminStage), where('type', '==', adminType));
                const snap = await getDocs(q);
                snap.forEach(doc => { localStudentsCache[doc.id] = doc.data().name; });
                return localStudentsCache;
            };

            const draw = () => {
                render(`
                    <div class="bg-blue-800 p-3 rounded-2xl text-white shadow-lg mb-4 flex justify-between gap-2 items-center animate-in">
                        <select id="adm-filter-stage" class="bg-blue-700 text-white font-bold rounded-xl p-2 text-xs border-none outline-none cursor-pointer">
                            <option value="الأولى" ${adminStage === 'الأولى' ? 'selected' : ''}>الأولى</option>
                            <option value="الثانية" ${adminStage === 'الثانية' ? 'selected' : ''}>الثانية</option>
                            <option value="الثالثة" ${adminStage === 'الثالثة' ? 'selected' : ''}>الثالثة</option>
                            <option value="الرابعة" ${adminStage === 'الرابعة' ? 'selected' : ''}>الرابعة</option>
                        </select>
                        <select id="adm-filter-type" class="bg-blue-700 text-white font-bold rounded-xl p-2 text-xs border-none outline-none cursor-pointer">
                            <option value="صباحي" ${adminType === 'صباحي' ? 'selected' : ''}>صباحي</option>
                            <option value="مسائي" ${adminType === 'مسائي' ? 'selected' : ''}>مسائي</option>
                            <option value="استضافة صباحي" ${adminType === 'استضافة صباحي' ? 'selected' : ''}>استضافة صباحي</option>
                        </select>
                    </div>
                    <nav class="flex bg-white p-2 rounded-3xl shadow-xl gap-2 mb-4">
                        <button id="tab-scan" class="flex-1 py-4 rounded-2xl font-black transition-all duration-100 ${currentTab === 'scan' ? 'bg-blue-600 text-white shadow-lg scale-[1.02]' : 'text-slate-400'}">المسح</button>
                        <button id="tab-logs" class="flex-1 py-4 rounded-2xl font-black transition-all duration-100 ${currentTab === 'logs' ? 'bg-indigo-600 text-white shadow-lg scale-[1.02]' : 'text-slate-400'}">الحضور</button>
                        <button id="tab-members" class="flex-1 py-4 rounded-2xl font-black transition-all duration-100 ${currentTab === 'members' ? 'bg-green-600 text-white shadow-lg scale-[1.02]' : 'text-slate-400'}">الطلاب</button>
                    </nav>
                    <div id="admin-content" class="bg-white p-6 rounded-[2.5rem] shadow-xl min-h-[400px]"></div>
                    <button id="back-home-admin" class="w-full mt-8 py-4 bg-white text-blue-600 rounded-2xl font-black flex justify-center gap-2 items-center border border-blue-100 transition-colors hover:bg-blue-50">
                        <i data-lucide="home"></i> عودة الى شاشة رئيسية
                    </button>
                `);
                prefetchStudents();
                document.getElementById('adm-filter-stage').onchange = (e) => { adminStage = e.target.value; localStorage.setItem('adminStage', adminStage); stopScanner(); draw(); };
                document.getElementById('adm-filter-type').onchange = (e) => { adminType = e.target.value; localStorage.setItem('adminType', adminType); stopScanner(); draw(); };
                document.getElementById('tab-scan').onclick = () => { currentTab = 'scan'; stopScanner(); draw(); };
                document.getElementById('tab-logs').onclick = () => { currentTab = 'logs'; stopScanner(); draw(); };
                document.getElementById('tab-members').onclick = () => { currentTab = 'members'; stopScanner(); draw(); };
                document.getElementById('back-home-admin').onclick = goBackToHome;
                if (currentTab === 'scan') drawScanner(); else if (currentTab === 'logs') drawLogs(); else drawMembers();
            };

            const stopScanner = () => { if (html5QrCode) { try { html5QrCode.stop(); } catch(e) {} html5QrCode = null; } };

            const drawScanner = () => {
                document.getElementById('admin-content').innerHTML = `
                    <div class="space-y-4 animate-in">
                        <select id="sel-sub" class="w-full p-4 bg-slate-50 rounded-2xl border-none font-bold text-blue-700 outline-none text-center shadow-sm"><option value="">جاري التحميل...</option></select>
                        <div id="reader-container" class="w-full aspect-square bg-slate-900 rounded-[2.5rem] overflow-hidden shadow-2xl relative"><div id="reader"></div></div>
                        <button id="start-scan" class="w-full py-5 bg-blue-600 text-white font-black rounded-2xl shadow-xl flex items-center justify-center gap-2 transition-transform active:scale-95"><i data-lucide="zap"></i> تشغيل الكاميرا</button>
                        <button id="stop-scan" class="w-full py-5 bg-slate-100 text-slate-500 font-black rounded-2xl hidden transition-transform active:scale-95">إيقاف</button>
                    </div>
                `;
                const selSub = document.getElementById('sel-sub');
                onSnapshot(query(collection(db, 'artifacts', appId, 'public', 'data', 'subjects'), where('stage', '==', adminStage), where('type', '==', adminType)), (snap) => {
                    selSub.innerHTML = snap.empty ? '<option disabled selected>لا توجد مواد</option>' : '';
                    snap.forEach(d => selSub.innerHTML += `<option value="${d.data().name}">${d.data().name}</option>`);
                });
                document.getElementById('start-scan').onclick = async () => {
                    if (!selSub.value || selSub.value.includes('تحميل')) return notify('اختر مادة أولاً', true);
                    document.getElementById('start-scan').classList.add('hidden'); document.getElementById('stop-scan').classList.remove('hidden');
                    const sessionScanned = new Set();
                    html5QrCode = new Html5Qrcode("reader");
                    const config = { fps: 120, qrbox: { width: 290, height: 290 }, aspectRatio: 1.0, disableFlip: true, videoConstraints: { facingMode: "environment", width: { ideal: 1920 }, height: { ideal: 1080 }, focusMode: "continuous" } };
                    html5QrCode.start({ facingMode: "environment" }, config, (text) => {
                        if (sessionScanned.has(text)) return; 
                        const studentName = localStudentsCache[text];
                        if (studentName) {
                            sessionScanned.add(text); setTimeout(() => sessionScanned.delete(text), 120000);
                            notify(`تم: ${studentName}`); if (navigator.vibrate) navigator.vibrate(50); 
                            const today = new Date().toISOString().split('T')[0];
                            addDoc(collection(db, 'artifacts', appId, 'public', 'data', 'attendance'), { studentId: text, studentName: studentName, subject: selSub.value, stage: adminStage, type: adminType, date: today, time: new Date().toLocaleTimeString('ar-EG'), timestamp: serverTimestamp() }).catch(err => { notify(`فشل حفظ: ${studentName}`, true); sessionScanned.delete(text); });
                        } 
                    }).catch(() => notify("تأكد من إذن الكاميرا", true));
                };
                document.getElementById('stop-scan').onclick = () => { stopScanner(); document.getElementById('start-scan').classList.remove('hidden'); document.getElementById('stop-scan').classList.add('hidden'); };
            };

            const drawLogs = () => {
                const date = new Date().toISOString().split('T')[0];
                document.getElementById('admin-content').innerHTML = `
                    <div class="space-y-4 animate-in">
                        <div class="flex flex-col gap-3">
                             <div class="flex justify-between items-center"><h4 class="font-black text-sm text-slate-800">سجل الحضور</h4><div class="flex gap-2"><button id="btn-download" class="px-3 py-2 bg-green-50 text-green-600 rounded-xl text-xs font-black hover:bg-green-100 transition-colors">تنزيل ملف CSV</button><button id="btn-manage-subjects" class="px-3 py-2 bg-indigo-50 text-indigo-600 rounded-xl text-xs font-black hover:bg-indigo-100 transition-colors">المواد</button></div></div>
                             <button id="btn-add-manual" class="w-full py-3 bg-blue-50 text-blue-600 rounded-2xl font-black text-sm flex items-center justify-center gap-2 border border-blue-100 hover:bg-blue-100 transition-colors"><i data-lucide="plus-circle" size="16"></i> إضافة حضور يدوي</button>
                        </div>
                        <div class="grid grid-cols-2 gap-2"><select id="log-sub" class="p-3 bg-slate-50 rounded-xl border-none text-[10px] font-black outline-none shadow-sm"></select><input id="log-date" type="date" value="${date}" class="p-3 bg-slate-50 rounded-xl border-none text-[10px] font-black text-center shadow-sm"></div>
                        <div id="attendance-list" class="space-y-2 max-h-[350px] overflow-y-auto no-scrollbar"></div>
                    </div>
                `;
                const logSub = document.getElementById('log-sub');
                let unsubLogs = null;
                const update = () => {
                    const sub = logSub.value; const d = document.getElementById('log-date').value;
                    if (!sub || sub.includes('توجد')) return;
                    if (unsubLogs) unsubLogs();
                    unsubLogs = onSnapshot(query(collection(db, 'artifacts', appId, 'public', 'data', 'attendance'), where('stage', '==', adminStage), where('type', '==', adminType), where('subject', '==', sub), where('date', '==', d)), (snap) => {
                        currentLogData = snap.docs.map(doc => ({id: doc.id, ...doc.data()})).sort((a,b) => b.timestamp - a.timestamp);
                        document.getElementById('attendance-list').innerHTML = currentLogData.map(a => `<div class="p-4 bg-slate-50 rounded-2xl flex justify-between items-center border-r-4 border-indigo-500 shadow-sm animate-in"><div><p class="font-bold text-sm text-slate-800">${a.studentName}</p><p class="text-[10px] text-slate-400 font-bold">${a.time}</p></div><button onclick="window.deleteEntry('att', '${a.id}')" class="text-red-500 p-2 hover:bg-red-50 rounded-full transition-all"><i data-lucide="trash-2" size="20"></i></button></div>`).join('') || '<div class="text-center py-10 text-slate-300">السجل فارغ</div>';
                        lucide.createIcons();
                    });
                };
                onSnapshot(query(collection(db, 'artifacts', appId, 'public', 'data', 'subjects'), where('stage', '==', adminStage), where('type', '==', adminType)), (snap) => {
                    logSub.innerHTML = snap.empty ? '<option disabled selected>لا توجد مواد</option>' : '';
                    snap.forEach(d => logSub.innerHTML += `<option>${d.data().name}</option>`); update();
                });
                logSub.onchange = update; document.getElementById('log-date').onchange = update;
                
                // CSV Export Logic with BOM for Arabic support
                document.getElementById('btn-download').onclick = () => {
                    if (!currentLogData || currentLogData.length === 0) return notify('لا توجد بيانات للتنزيل', true);
                    const sub = logSub.value;
                    const dateVal = document.getElementById('log-date').value;
                    
                    let csvContent = "\uFEFF"; // BOM for Excel Arabic support
                    csvContent += "ت,الاسم الرباعي,المادة,التاريخ,وقت الحضور\n";

                    currentLogData.forEach((item, index) => {
                        const name = item.studentName.replace(/,/g, " "); // Handle commas in names
                        const row = `${index + 1},${name},${sub},${dateVal},${item.time}`;
                        csvContent += row + "\n";
                    });

                    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
                    const url = URL.createObjectURL(blob);
                    const link = document.createElement('a');
                    link.href = url;
                    link.download = `حضور_${sub}_${dateVal}.csv`;
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                };

                document.getElementById('btn-add-manual').onclick = async () => {
                    if (!logSub.value || logSub.value.includes('تحميل') || logSub.value.includes('توجد')) return notify('اختر مادة أولاً', true);
                    const students = await prefetchStudents();
                    const sel = document.getElementById('manual-stu-select'); sel.innerHTML = '<option value="">اختر الطالب...</option>';
                    Object.entries(students).forEach(([uid, name]) => { sel.innerHTML += `<option value="${uid}">${name}</option>`; });
                    document.getElementById('manual-modal').classList.add('active');
                };
                document.getElementById('btn-confirm-manual').onclick = async () => {
                    const uid = document.getElementById('manual-stu-select').value;
                    if (!uid) return notify('يرجى اختيار طالب', true);
                    await addDoc(collection(db, 'artifacts', appId, 'public', 'data', 'attendance'), { studentId: uid, studentName: localStudentsCache[uid], subject: logSub.value, stage: adminStage, type: adminType, date: new Date().toISOString().split('T')[0], time: new Date().toLocaleTimeString('ar-EG'), timestamp: serverTimestamp() });
                    notify('تمت الإضافة يدوياً'); document.getElementById('manual-modal').classList.remove('active');
                };
                document.getElementById('manual-close-btn').onclick = () => document.getElementById('manual-modal').classList.remove('active');
                
                document.getElementById('btn-manage-subjects').onclick = () => {
                    document.getElementById('pin-modal').classList.add('active');
                    document.getElementById('subject-pin-input').value = '';
                    document.getElementById('subject-pin-input').focus();
                };

                document.getElementById('btn-pin-cancel').onclick = () => document.getElementById('pin-modal').classList.remove('active');
                document.getElementById('btn-pin-confirm').onclick = () => {
                    if (document.getElementById('subject-pin-input').value === "122109") {
                        document.getElementById('pin-modal').classList.remove('active');
                        openSubjectModal();
                    } else { notify('الرمز غير صحيح', true); }
                };

                const openSubjectModal = () => {
                    document.getElementById('sub-modal-stage').innerText = adminStage; document.getElementById('sub-modal-type').innerText = adminType;
                    onSnapshot(query(collection(db, 'artifacts', appId, 'public', 'data', 'subjects'), where('stage', '==', adminStage), where('type', '==', adminType)), (snap) => {
                        const list = document.getElementById('current-subjects-list'); list.innerHTML = '';
                        snap.forEach(d => {
                             const b = document.createElement('button'); b.className = "bg-red-50 text-red-500 px-3 py-1 rounded-lg text-xs font-bold border border-red-100 flex items-center gap-1 m-1 hover:bg-red-100 transition-colors";
                             b.innerHTML = `${d.data().name} <i data-lucide="x" size="10"></i>`; b.onclick = () => deleteDoc(doc(db, 'artifacts', appId, 'public', 'data', 'subjects', d.id)); list.appendChild(b);
                        }); lucide.createIcons();
                    });
                    document.getElementById('subject-modal').classList.add('active');
                };

                document.getElementById('btn-save-subject').onclick = async () => {
                    const name = document.getElementById('new-subject-name').value.trim();
                    if(name) await addDoc(collection(db, 'artifacts', appId, 'public', 'data', 'subjects'), { name, stage: adminStage, type: adminType });
                    document.getElementById('new-subject-name').value = '';
                };
                document.getElementById('subject-close-btn').onclick = () => document.getElementById('subject-modal').classList.remove('active');
            };

            const drawMembers = () => {
                document.getElementById('admin-content').innerHTML = `<div class="space-y-4 animate-in"><h4 class="font-black text-slate-800">إدارة الطلاب</h4><div id="members-list" class="space-y-2 max-h-[350px] overflow-y-auto no-scrollbar"></div></div>`;
                onSnapshot(query(collection(db, 'artifacts', appId, 'public', 'data', 'members'), where('stage', '==', adminStage), where('type', '==', adminType)), (snap) => {
                      document.getElementById('members-list').innerHTML = snap.docs.map(d => `<div class="p-4 bg-slate-50 rounded-2xl flex justify-between items-center border shadow-sm animate-in"><div><p class="font-bold text-sm text-slate-800">${d.data().name}</p><p class="text-[10px] text-blue-600 font-black">الرمز: ${d.data().pin}</p></div><button onclick="window.deleteEntry('mem', '${d.id}')" class="text-red-500 p-2 hover:bg-red-50 rounded-full transition-all"><i data-lucide="trash-2" size="20"></i></button></div>`).join('') || '<p class="text-center py-10 text-slate-300">لا يوجد طلاب</p>';
                      lucide.createIcons();
                });
            };
            draw();
        };
        startApp();
    </script>
</body>
</html>
